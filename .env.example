# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real secrets.

# Anthropic API key. Used server-side only, for recipe parsing.
# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Neon Postgres connection string. Needed once the Postgres repository
# adapter is wired up; leave blank while running the in-memory adapter.
DATABASE_URL=
